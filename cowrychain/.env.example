# --- Next.js Frontend Configuration ---
# Get your own at https://cloud.walletconnect.com — do not ship someone else's.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="YOUR_WALLETCONNECT_PROJECT_ID"
NEXT_PUBLIC_IS_TESTNET="false"
NEXT_PUBLIC_EXPLORER_URL="https://basescan.org"

# --- Gas sponsorship (optional) ---
# Coinbase CDP paymaster endpoint. When set, CowryChain sponsors user gas and the
# transactions are BILLED TO THE ACCOUNT THAT OWNS THIS KEY. The CDP project must
# be funded, and the vault + ERC-20 contracts allowlisted, or sponsorship is denied.
#
# Leave this EMPTY to have users pay their own gas (a fraction of a cent on Base).
# The landing page copy switches automatically: it only claims "100% Gasless" when
# a real URL is set here. A placeholder containing YOUR_API_KEY is treated as unset.
#
# Get one at https://portal.cdp.coinbase.com → Paymaster → Base Mainnet
NEXT_PUBLIC_PAYMASTER_URL=""

# --- Token Zapping (0x Swap API) ---
# SECRET — server-side only, NO NEXT_PUBLIC_ prefix. Held by /api/zap-quote and
# never sent to the browser. Enables "zap any token into a vault" via the 0x router.
# Leave empty to disable zapping gracefully (the UI shows "routing unavailable" and
# users can still deposit the vault asset directly).
# Get a free key at https://dashboard.0x.org
ZAP_0X_API_KEY=""

# --- Hardhat Smart Contract Deployment Configuration ---
# Your wallet's private key (Starts with 0x. DO NOT commit this to GitHub!)
PRIVATE_KEY=""
# Block explorer API Key for verifying the smart contracts
BASESCAN_API_KEY=""
